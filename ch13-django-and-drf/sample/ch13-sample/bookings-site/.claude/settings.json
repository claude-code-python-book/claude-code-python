{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run manage.py check *)",
      "Bash(uv run manage.py makemigrations *)",
      "Bash(uv run manage.py sqlmigrate *)",
      "Bash(uv run manage.py showmigrations *)"
    ],
    "ask": [
      "Bash(uv run manage.py migrate *)",
      "Bash(uv run manage.py squashmigrations *)",
      "Bash(uv add *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./config/settings/prod.py)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_migrations.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
