{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run python tools/check_migrations.py *)",
      "Bash(uv run alembic check)",
      "Bash(uv run alembic heads)",
      "Bash(uv run alembic history *)",
      "Bash(uv run alembic current)"
    ],
    "ask": [
      "Bash(uv run alembic upgrade *)",
      "Bash(uv run alembic downgrade *)",
      "Bash(uv run alembic stamp *)",
      "Bash(uv add *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check_migration.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
