{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run --group security bandit *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(docker build *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(gh pr create *)",
      "Bash(uv add *)",
      "Bash(uv run alembic *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(helm *)",
      "Bash(kubectl *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pytest_gate.py"],
            "timeout": 300,
            "statusMessage": "Running pytest"
          }
        ]
      }
    ]
  }
}
